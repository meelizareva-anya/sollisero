# Sollisero — nginx site config.
# GENERATED by `node build.mjs` from deploy/nginx.conf.template → deploy/nginx.conf. Edit the template.
#
# Layout on the server:
#   /var/www/sollisero/current/     ← contents of dist/ (atomic deploy: upload to releases/<ts>, then switch the symlink)
#   leads API (server/leads-server.mjs or your backend) on 127.0.0.1:8787

server {
    listen 80;
    listen [::]:80;
    server_name sollisero.com www.sollisero.com;
    return 301 https://sollisero.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sollisero.com;

    # ssl_certificate     /etc/letsencrypt/live/sollisero.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/sollisero.com/privkey.pem;

    root /var/www/sollisero/current;
    index index.html;
    charset utf-8;

    # ---- security headers (identical to tools/preview.mjs) ----
    add_header Content-Security-Policy "%CSP%" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;
    add_header X-Frame-Options "DENY" always;

    # ---- compression ----
    gzip on;
    gzip_comp_level 6;
    gzip_types text/css application/javascript text/javascript image/svg+xml application/xml application/json;

    # ---- caching: hashed assets forever, HTML always revalidated ----
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Security-Policy "%CSP%" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "%CSP%" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
    }

    # Pretty URLs: /dspm → /dspm.html
    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    # ---- forms API ----
    location /api/ {
        client_max_body_size 32k;
        limit_req zone=leads burst=5 nodelay;   # declare in http{}: limit_req_zone $binary_remote_addr zone=leads:10m rate=10r/m;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
    }

    error_page 404 /404.html;
}
