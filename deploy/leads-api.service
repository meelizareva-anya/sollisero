# systemd unit for the reference leads API. Install: /etc/systemd/system/sollisero-leads.service
[Unit]
Description=Sollisero leads API
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/sollisero/app
ExecStart=/usr/bin/node server/leads-server.mjs
Environment=PORT=8787
Environment=LEADS_FILE=/var/lib/sollisero/leads.jsonl
# Environment=LEAD_WEBHOOK_URL=https://your-crm.example/webhook
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sollisero

[Install]
WantedBy=multi-user.target
